            <li><a href="#um-okkur">Um okkur</a></li>
            <li><a href="#spurningar">Spurningar</a></li>
          </ul>
        </div>
        <div>
          <h5>Aðgangur</h5>
          <ul>
            <li><a href="/login">Innskráning fyrirtækja</a></li>
            <li><a href="#boka-fund">Hafa samband</a></li>
