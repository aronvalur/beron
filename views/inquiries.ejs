<%- include('partials/head', { title: 'Fyrirspurnir' }) %>
<%- include('partials/nav') %>

  <div class="page-header">
    <div>
      <h1>Fyrirspurnir</h1>
      <p class="subtitle">Þarf breytingu, lenda í vesen eða hefur spurningu? Sendu Beron línu hér.</p>
    </div>
  </div>

  <% if (sent) { %><div class="alert alert-success">Sent - Beron hefur samband fljótlega.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <h2>Ný fyrirspurn</h2>
    <form method="POST" action="/fyrirspurnir" style="max-width:520px;">
      <div class="field">
        <label for="message">Skilaboð</label>
        <textarea id="message" name="message" rows="4" required placeholder="Skrifaðu fyrirspurnina þína hér..."></textarea>
      </div>
      <button type="submit" class="btn">Senda fyrirspurn</button>
    </form>
  </div>

  <div class="card">
    <h2>Fyrri fyrirspurnir</h2>
    <% if (inquiries.length === 0) { %>
      <div class="table-empty">Engar fyrirspurnir sendar ennþá.</div>
    <% } else { %>
      <div style="display:flex; flex-direction:column; gap:14px;">
        <% inquiries.forEach(function(i) { %>
          <div style="border:1px solid var(--border); border-radius:10px; padding:14px 16px;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px;">
              <span style="font-size:12.5px; color:var(--text-muted); font-weight:700;"><%= formatDate(i.created_at) %></span>
              <% if (i.status === 'closed') { %>
                <span class="badge badge-delivered">Lokið</span>
              <% } else if (i.status === 'contacted') { %>
                <span class="badge badge-ordered">Í vinnslu</span>
              <% } else { %>
                <span class="badge badge-pending">Móttekið</span>
              <% } %>
            </div>

            <div style="display:flex; flex-direction:column; gap:8px;">
              <% (i.messages || []).forEach(function(m) { %>
                <% if (m.sender === 'beron') { %>
                  <div style="align-self:flex-start; max-width:85%; padding:10px 12px; background:var(--success-bg); border-radius:8px; border-left:3px solid var(--brand);">
                    <div style="font-size:11px; font-weight:800; color:var(--brand); text-transform:uppercase; letter-spacing:0.03em; margin-bottom:4px;">Beron &middot; <%= formatDate(m.created_at) %></div>
                    <div style="font-size:14px;"><%= m.body %></div>
                  </div>
                <% } else { %>
                  <div style="align-self:flex-end; max-width:85%; padding:10px 12px; background:var(--bg); border-radius:8px;">
                    <div style="font-size:11px; font-weight:800; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.03em; margin-bottom:4px;">Þú &middot; <%= formatDate(m.created_at) %></div>
                    <div style="font-size:14px;"><%= m.body %></div>
                  </div>
                <% } %>
              <% }); %>
            </div>

            <% if (i.status === 'closed') { %>
              <p class="hint" style="color:var(--text-muted); font-size:13px; margin-top:12px;">Þessari fyrirspurn er lokað.</p>
            <% } else { %>
              <div style="margin-top:12px; display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
                <form method="POST" action="/fyrirspurnir/<%= i.id %>/reply" style="flex:1; min-width:220px; display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
                  <div class="field" style="flex:1; min-width:220px; margin-bottom:0;">
                    <label>Svara</label>
                    <textarea name="message" rows="2" placeholder="Skrifaðu skilaboð..." required></textarea>
                  </div>
                  <button type="submit" class="btn btn-sm">Senda</button>
                </form>
                <form method="POST" action="/fyrirspurnir/<%= i.id %>/close" onsubmit="return confirm('Loka þessari fyrirspurn?');">
                  <button type="submit" class="btn btn-sm btn-secondary">Loka</button>
                </form>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

<%- include('partials/footer') %>
