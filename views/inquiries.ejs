<%- include('partials/head', { title: 'Fyrirspurnir' }) %>
<%- include('partials/nav') %>

  <div class="page-header">
    <div>
      <h1>Fyrirspurnir</h1>
      <p class="subtitle">Þarf breytingu, lenda í vesen eða hefur spurningu? Sendu Beron línu hér.</p>
    </div>
  </div>

  <% if (sent) { %><div class="alert alert-success">Sent - Beron hefur samband fljótlega.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <h2>Ný fyrirspurn</h2>
    <form method="POST" action="/fyrirspurnir" style="max-width:520px;">
      <div class="field">
        <label for="message">Skilaboð</label>
        <textarea id="message" name="message" rows="4" required placeholder="Skrifaðu fyrirspurnina þína hér..."></textarea>
      </div>
      <button type="submit" class="btn">Senda fyrirspurn</button>
    </form>
  </div>

  <div class="card">
    <h2>Fyrri fyrirspurnir</h2>
    <% if (inquiries.length === 0) { %>
      <div class="table-empty">Engar fyrirspurnir sendar ennþá.</div>
    <% } else { %>
      <div style="display:flex; flex-direction:column; gap:14px;">
        <% inquiries.forEach(function(i) { %>
          <div style="border:1px solid var(--border); border-radius:10px; padding:14px 16px;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:8px;">
              <span style="font-size:12.5px; color:var(--text-muted); font-weight:700;"><%= formatDate(i.created_at) %></span>
              <% if (i.status === 'closed') { %>
                <span class="badge badge-delivered">Lokið</span>
              <% } else if (i.status === 'contacted') { %>
                <span class="badge badge-ordered">Í vinnslu</span>
              <% } else { %>
                <span class="badge badge-pending">Móttekið</span>
              <% } %>
            </div>
            <div style="font-size:14px;"><%= i.message %></div>
            <% if (i.reply) { %>
              <div style="margin-top:12px; padding:10px 12px; background:var(--bg); border-radius:8px; border-left:3px solid var(--brand);">
                <div style="font-size:11.5px; font-weight:800; color:var(--brand); text-transform:uppercase; letter-spacing:0.03em; margin-bottom:4px;">
                  Svar frá Beron<% if (i.replied_at) { %> &middot; <%= formatDate(i.replied_at) %><% } %>
                </div>
                <div style="font-size:14px;"><%= i.reply %></div>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

<%- include('partials/footer') %>
