<%- include('partials/head', { title: 'Fyrirspurnir' }) %>
<%- include('partials/nav') %>

  <div class="page-header">
    <div>
      <h1>Fyrirspurnir</h1>
      <p class="subtitle">Þarf breytingu, lenda í vesen eða hefur spurningu? Sendu Beron línu hér.</p>
    </div>
  </div>

  <% if (sent) { %><div class="alert alert-success">Sent - Beron hefur samband fljótlega.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <h2>Ný fyrirspurn</h2>
    <form method="POST" action="/fyrirspurnir" style="max-width:520px;">
      <div class="field">
        <label for="message">Skilaboð</label>
        <textarea id="message" name="message" rows="4" required placeholder="Skrifaðu fyrirspurnina þína hér..."></textarea>
      </div>
      <button type="submit" class="btn">Senda fyrirspurn</button>
    </form>
  </div>

  <div class="card">
    <h2>Fyrri fyrirspurnir</h2>
    <% if (inquiries.length === 0) { %>
      <div class="table-empty">Engar fyrirspurnir sendar ennþá.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Sent</th><th>Skilaboð</th><th>Staða</th></tr></thead>
        <tbody>
          <% inquiries.forEach(function(i) { %>
            <tr>
              <td><%= formatDate(i.created_at) %></td>
              <td style="max-width:420px;"><%= i.message %></td>
              <td>
                <% if (i.status === 'closed') { %>
                  <span class="badge badge-delivered">Lokið</span>
                <% } else if (i.status === 'contacted') { %>
                  <span class="badge badge-ordered">Í vinnslu</span>
                <% } else { %>
                  <span class="badge badge-pending">Móttekið</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

<%- include('partials/footer') %>
