<%- include('../partials/head', { title: company.name }) %>
<%- include('../partials/nav') %>

  <div class="page-header">
    <div>
      <h1><%= company.name %></h1>
      <p class="subtitle">Kennitala <%= company.kennitala %> &middot; <%= company.billing_email %></p>
    </div>
    <div class="btn-row">
      <form method="POST" action="/superadmin/companies/<%= company.id %>/subscription">
        <button type="submit" class="btn <%= subscription && subscription.active ? 'btn-danger' : '' %>">
          <%= subscription && subscription.active ? 'Gera áskrift óvirka' : 'Virkja áskrift' %>
        </button>
      </form>
      <form method="POST" action="/superadmin/companies/<%= company.id %>/delete"
            onsubmit="return confirm('Eyða <%= company.name %> - öllum starfsmönnum, gjafapöntunum og innskráningum tengiliða? Þessu er ekki hægt að skila.') && confirm('Ertu alveg viss? Þetta eyðir fyrirtækinu endanlega og er ekki hægt að afturkalla.');">
        <button type="submit" class="btn btn-danger">Eyða fyrirtæki</button>
      </form>
    </div>
  </div>

  <% if (justCreated && newPassword) { %>
    <div class="alert alert-success">
      Fyrirtækið er stofnað. Innskráning fyrsta tengiliðar: <strong><%= admins[0] ? admins[0].email : '' %></strong> / <strong><%= newPassword %></strong><br>
      <span style="font-weight:500;">Þetta lykilorð birtist bara núna - sendu það á viðskiptavininn, þau geta breytt því sjálf undir Stillingar eftir innskráningu.</span>
    </div>
  <% } %>

  <% if (justReset && newPassword) { %>
    <div class="alert alert-success">
      Lykilorði var endurstillt fyrir <strong><%= resetEmail %></strong>: <strong><%= newPassword %></strong><br>
      <span style="font-weight:500;">Þetta birtist bara núna - sendu það á viðskiptavininn, þau geta breytt því sjálf undir Stillingar eftir innskráningu.</span>
    </div>
  <% } %>

  <div class="grid grid-3">
    <div class="card stat-card">
      <div class="stat-value"><%= employees.length %></div>
      <div class="stat-label">Starfsmenn</div>
    </div>
    <div class="card stat-card">
      <div class="stat-value"><%= orders.length %></div>
      <div class="stat-label">Gjafapantanir samtals</div>
    </div>
    <div class="card stat-card">
      <div class="stat-value"><%= plan ? plan.label : '—' %></div>
      <div class="stat-label">Áskrift</div>
    </div>
  </div>

  <div class="card">
    <h2>Tengiliðir</h2>
    <table>
      <thead><tr><th>Nafn</th><th>Netfang</th><th>Sími</th><th>Lykilorð gleymt?</th></tr></thead>
      <tbody>
        <% admins.forEach(function(a) { %>
          <tr>
            <td><%= a.name %></td>
            <td><%= a.email %></td>
            <td><% if (a.phone) { %><a href="tel:<%= a.phone %>"><%= a.phone %></a><% } else { %>—<% } %></td>
            <td>
              <form class="inline note-form" method="POST" action="/superadmin/companies/<%= company.id %>/admins/<%= a.id %>/reset-password"
                    onsubmit="return confirm('Endurstilla lykilorð fyrir ' + '<%= a.email %>' + '?');">
                <input type="text" name="password" placeholder="beron123 (sjálfgefið ef autt)">
                <button type="submit" class="btn btn-sm btn-secondary">Endurstilla lykilorð</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Starfsmenn</h2>
    <table>
      <thead><tr><th>Nafn</th><th>Afmæli</th><th>Deild</th><th>Staða</th></tr></thead>
      <tbody>
        <% employees.forEach(function(e) { %>
          <tr>
            <td><%= e.name %></td>
            <td><%= formatDayMonth(e.birthday) %></td>
            <td><%= e.department || '—' %></td>
            <td><span class="badge badge-<%= e.active ? 'active' : 'inactive' %>"><%= e.active ? 'Virkur' : 'Óvirkur' %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Gjafapantanir</h2>
    <% if (orders.length === 0) { %>
      <div class="table-empty">Engar gjafapantanir ennþá.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Starfsmaður</th><th>Tegund</th><th>Staða</th></tr></thead>
        <tbody>
          <% orders.forEach(function(o) { %>
            <tr>
              <td><%= (employees.find(e => e.id === o.employee_id) || {}).name || '—' %></td>
              <td><span class="badge badge-<%= o.gift_type %>"><%= o.occasion || eventTypeLabel(o.gift_type) %></span></td>
              <td><span class="badge badge-<%= o.status %>"><%= statusLabel(o.status) %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

<%- include('../partials/footer') %>
