<%- include('../partials/head', { title: 'Nýtt fyrirtæki' }) %>
<%- include('../partials/nav') %>

  <div class="page-header">
    <div>
      <h1>Nýtt fyrirtæki</h1>
      <p class="subtitle">Stofnaðu fyrirtæki og fyrsta tengilið þeirra í einu - tengiliðurinn getur breytt lykilorðinu sínu sjálfur eftir fyrstu innskráningu.</p>
    </div>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card" style="max-width:640px;">
    <form method="POST" action="/superadmin/companies">
      <div class="section-title">Fyrirtæki</div>
      <div class="field">
        <label for="name">Nafn fyrirtækis</label>
        <input type="text" id="name" name="name" required value="<%= formValues.name || '' %>">
      </div>
      <div class="field-row">
        <div class="field">
          <label for="kennitala">Kennitala</label>
          <input type="text" id="kennitala" name="kennitala" value="<%= formValues.kennitala || '' %>">
        </div>
        <div class="field">
          <label for="billing_email">Netfang vegna greiðslna</label>
          <input type="email" id="billing_email" name="billing_email" value="<%= formValues.billing_email || '' %>">
        </div>
      </div>
      <div class="field">
        <label for="billing_address">Heimilisfang vegna greiðslna</label>
        <input type="text" id="billing_address" name="billing_address" value="<%= formValues.billing_address || '' %>">
      </div>

      <div class="section-title">Áskrift</div>
      <label class="plan-option">
        <input type="radio" name="subscription_plan" value="birthdays" <%= (formValues.subscription_plan || 'birthdays') === 'birthdays' ? 'checked' : '' %>>
        <div>
          <div class="plan-title"><%= PLANS.birthdays.label %></div>
          <div class="plan-desc"><%= PLANS.birthdays.description %></div>
        </div>
      </label>
      <label class="plan-option">
        <input type="radio" name="subscription_plan" value="birthdays_christmas" <%= formValues.subscription_plan === 'birthdays_christmas' ? 'checked' : '' %>>
        <div>
          <div class="plan-title"><%= PLANS.birthdays_christmas.label %></div>
          <div class="plan-desc"><%= PLANS.birthdays_christmas.description %></div>
        </div>
      </label>

      <div class="section-title">Fyrsti tengiliður</div>
      <div class="field-row">
        <div class="field">
          <label for="contact_name">Nafn</label>
          <input type="text" id="contact_name" name="contact_name" required value="<%= formValues.contact_name || '' %>">
        </div>
        <div class="field">
          <label for="contact_email">Netfang (innskráning)</label>
          <input type="email" id="contact_email" name="contact_email" required value="<%= formValues.contact_email || '' %>">
        </div>
      </div>
      <div class="field">
        <label for="password">Bráðabirgðalykilorð</label>
        <input type="text" id="password" name="password" placeholder="beron123 (sjálfgefið ef autt)">
        <div class="hint">Gefðu tengiliðnum þetta lykilorð - þau geta breytt því sjálf undir Stillingar eftir innskráningu.</div>
      </div>

      <div class="btn-row">
        <button type="submit" class="btn">Stofna fyrirtæki</button>
        <a href="/superadmin/companies" class="btn btn-secondary">Hætta við</a>
      </div>
    </form>
  </div>

<%- include('../partials/footer') %>
