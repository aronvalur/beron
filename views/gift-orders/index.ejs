<%- include('../partials/head', { title: 'Öll tilefni' }) %>
<%- include('../partials/nav') %>

  <div class="page-header">
    <div>
      <h1>Öll tilefni</h1>
    </div>
    <a href="/gift-orders/custom/new" class="btn">+ Sérpöntun</a>
  </div>

  <% if (cancelled || skipped) { %><div class="alert alert-success">Hætt við.</div><% } %>
  <% if (restored) { %><div class="alert alert-success">Tekið til baka.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <%
    function filterUrl(newType, newRange) {
      const t = newType !== undefined ? newType : filter;
      const r = newRange !== undefined ? newRange : range;
      const params = [];
      if (t && t !== 'all') params.push('type=' + t);
      if (r && r !== 'all') params.push('range=' + r);
      return '/gift-orders' + (params.length ? '?' + params.join('&') : '');
    }
  %>

  <div class="filters">
    <a href="<%= filterUrl('all') %>" class="<%= filter === 'all' ? 'active' : '' %>">Allt</a>
    <a href="<%= filterUrl('birthday') %>" class="<%= filter === 'birthday' ? 'active' : '' %>">Afmæli</a>
    <a href="<%= filterUrl('christmas') %>" class="<%= filter === 'christmas' ? 'active' : '' %>">Jól</a>
    <a href="<%= filterUrl('custom') %>" class="<%= filter === 'custom' ? 'active' : '' %>">Sérpöntun</a>
  </div>

  <div class="filters">
    <a href="<%= filterUrl(undefined, 'all') %>" class="<%= range === 'all' ? 'active' : '' %>">Allt tímabil</a>
    <a href="<%= filterUrl(undefined, 'today') %>" class="<%= range === 'today' ? 'active' : '' %>">Í dag</a>
    <a href="<%= filterUrl(undefined, '7') %>" class="<%= range === '7' ? 'active' : '' %>">Næstu 7 daga</a>
    <a href="<%= filterUrl(undefined, 'month') %>" class="<%= range === 'month' ? 'active' : '' %>">Þennan mánuð</a>
    <a href="<%= filterUrl(undefined, 'past') %>" class="<%= range === 'past' ? 'active' : '' %>">Liðið</a>
  </div>

  <div class="card">
    <% if (orders.length === 0 && range === 'past') { %>
      <div class="empty-state">
        <h3>Ekkert liðið ennþá</h3>
        <p>Tilefni sem eru liðin hjá birtast hér í staðinn fyrir að safnast upp í hinum flipunum.</p>
      </div>
    <% } else if (orders.length === 0) { %>
      <div class="empty-state">
        <h3>Ekkert framundan ennþá</h3>
        <p>Afmælis- og jólapantanir birtast hér sjálfkrafa. Notaðu „Sérpöntun" fyrir stöðuhækkanir, nýja starfsmenn og önnur sérstök tilefni.</p>
      </div>
    <% } else { %>
      <div class="table-scroll">
      <table>
        <thead><tr><th>Starfsmaður</th><th>Tegund</th><th>Dagsetning</th><th>Niðurtalning</th><th>Fjárhæð</th><th>Staða pöntunar</th><th>Athugasemd til Beron</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(function(o) { %>
            <tr>
              <td><%= o.employee ? o.employee.name : '—' %></td>
              <td><span class="badge badge-<%= o.gift_type %>"><%= o.occasion || eventTypeLabel(o.gift_type) %></span></td>
              <td><%= o.event ? formatDate(o.event.date) : '—' %></td>
              <td>
                <% if (o.daysAway === null) { %>
                  <span style="color:var(--text-muted);">—</span>
                <% } else if (o.daysAway < 0) { %>
                  <span style="color:var(--text-muted);"><%= Math.abs(o.daysAway) %> dagar síðan</span>
                <% } else if (o.daysAway === 0) { %>
                  <strong>Í dag</strong>
                <% } else if (o.daysAway === 1) { %>
                  <strong>Á morgun</strong>
                <% } else { %>
                  <strong><%= o.daysAway %> dagar</strong>
                <% } %>
              </td>
              <td>
                <%= o.budget_amount ? Number(o.budget_amount).toLocaleString('is-IS') + ' kr.' : '—' %>
                <% if (o.handling_fee) { %>
                  <div style="font-size:11.5px; color:var(--text-muted); font-weight:600;">+ <%= Number(o.handling_fee).toLocaleString('is-IS') %> kr. gjald</div>
                <% } %>
              </td>
              <td><span class="badge badge-<%= o.status %>"><%= statusLabel(o.status) %></span></td>
              <td>
                <% if (o.canEditNote) { %>
                  <details class="note-popover">
                    <summary class="note-toggle <%= o.notes ? 'has-note' : '' %>" aria-label="<%= o.notes ? 'Breyta athugasemd' : 'Bæta við athugasemd' %>">
                      <% if (o.notes) { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                      <% } else { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      <% } %>
                    </summary>
                    <div class="note-popover-panel">
                      <form method="POST" action="/gift-orders/<%= o.id %>/note">
                        <input type="hidden" name="redirect_to" value="/gift-orders">
                        <textarea name="notes" placeholder="Athugasemd til Beron"><%= o.notes || '' %></textarea>
                        <button type="submit" class="btn btn-sm btn-secondary" style="width:100%;">Vista</button>
                      </form>
                    </div>
                  </details>
                <% } else if (o.notes) { %>
                  <details class="note-popover">
                    <summary class="note-toggle has-note" aria-label="Sjá athugasemd (læst)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </summary>
                    <div class="note-popover-panel">
                      <div class="note-popover-readonly"><%= o.notes %></div>
                      <div class="note-popover-hint">Læst - innan við <%= NOTE_CUTOFF_DAYS %> dagar til stefnu.</div>
                    </div>
                  </details>
                <% } else { %>
                  <span style="font-size:13px; color:var(--text-muted);">—</span>
                <% } %>
              </td>
              <td class="actions-cell">
                <% if (o.canCancel) { %>
                  <form class="inline" method="POST" action="/gift-orders/<%= o.id %>/cancel" onsubmit="return confirm('Hætta við þessa sérpöntun?');">
                    <button type="submit" class="btn btn-sm btn-danger">Hætta við</button>
                  </form>
                <% } else if (o.gift_type === 'custom' && o.status !== 'delivered' && o.status !== 'cancelled') { %>
                  <button type="button" class="btn btn-sm btn-danger" disabled title="Of seint að hætta við - þarf að gerast minnst 7 dögum fyrir afhendingu.">Hætta við</button>
                <% } else if (o.canSkip) { %>
                  <form class="inline" method="POST" action="/gift-orders/<%= o.id %>/skip" onsubmit="return confirm('Hætta við þessari gjöf?');">
                    <button type="submit" class="btn btn-sm btn-danger">Hætta við</button>
                  </form>
                <% } else if (o.canRestore) { %>
                  <form class="inline" method="POST" action="/gift-orders/<%= o.id %>/restore" onsubmit="return confirm('Taka þessa pöntun til baka?');">
                    <button type="submit" class="btn btn-sm btn-success">Taka til baka</button>
                  </form>
                <% } else if (o.status === 'cancelled') { %>
                  <button type="button" class="btn btn-sm btn-success" disabled title="Of seint að taka til baka - dagsetningin er of nálægt eða liðin.">Taka til baka</button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <script>
    (function () {
      var popovers = Array.prototype.slice.call(document.querySelectorAll('.note-popover'));

      function positionPanel(details) {
        var summary = details.querySelector('summary');
        var panel = details.querySelector('.note-popover-panel');
        if (!summary || !panel) return;
        var rect = summary.getBoundingClientRect();
        var panelWidth = panel.offsetWidth || 260;
        var left = Math.min(rect.left, window.innerWidth - panelWidth - 12);
        panel.style.top = (rect.bottom + 6) + 'px';
        panel.style.left = Math.max(12, left) + 'px';
      }

      popovers.forEach(function (details) {
        details.addEventListener('toggle', function () {
          if (details.open) {
            // Only one note popover open at a time, and positioned with
            // fixed coords (via JS) so the table's horizontal-scroll
            // wrapper can't clip it like it would an absolutely positioned
            // dropdown.
            popovers.forEach(function (other) {
              if (other !== details) other.open = false;
            });
            positionPanel(details);
          }
        });
      });

      window.addEventListener('scroll', function () {
        popovers.forEach(function (details) {
          if (details.open) positionPanel(details);
        });
      }, true);
      window.addEventListener('resize', function () {
        popovers.forEach(function (details) {
          if (details.open) positionPanel(details);
        });
      });

      // Click outside any open popover closes it.
      document.addEventListener('click', function (e) {
        popovers.forEach(function (details) {
          if (details.open && !details.contains(e.target)) details.open = false;
        });
      });
    })();
  </script>

<%- include('../partials/footer') %>
