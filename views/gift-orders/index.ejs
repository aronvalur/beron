<%- include('../partials/head', { title: 'Framundan' }) %>
<%- include('../partials/nav') %>

  <div class="page-header">
    <div>
      <h1>Framundan</h1>
    </div>
    <a href="/gift-orders/custom/new" class="btn">+ Sérpöntun</a>
  </div>

  <% if (cancelled || skipped) { %><div class="alert alert-success">Hætt við.</div><% } %>
  <% if (restored) { %><div class="alert alert-success">Tekið til baka.</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <%
    function filterUrl(newType, newRange) {
      const t = newType !== undefined ? newType : filter;
      const r = newRange !== undefined ? newRange : range;
      const params = [];
      if (t && t !== 'all') params.push('type=' + t);
      if (r && r !== 'all') params.push('range=' + r);
      return '/gift-orders' + (params.length ? '?' + params.join('&') : '');
    }
  %>

  <div class="filters">
    <a href="<%= filterUrl('all') %>" class="<%= filter === 'all' ? 'active' : '' %>">Allt</a>
    <a href="<%= filterUrl('birthday') %>" class="<%= filter === 'birthday' ? 'active' : '' %>">Afmæli</a>
    <a href="<%= filterUrl('christmas') %>" class="<%= filter === 'christmas' ? 'active' : '' %>">Jól</a>
    <a href="<%= filterUrl('custom') %>" class="<%= filter === 'custom' ? 'active' : '' %>">Sérpöntun</a>
  </div>

  <div class="filters">
    <a href="<%= filterUrl(undefined, 'all') %>" class="<%= range === 'all' ? 'active' : '' %>">Allt tímabil</a>
    <a href="<%= filterUrl(undefined, 'today') %>" class="<%= range === 'today' ? 'active' : '' %>">Í dag</a>
    <a href="<%= filterUrl(undefined, '7') %>" class="<%= range === '7' ? 'active' : '' %>">Næstu 7 daga</a>
    <a href="<%= filterUrl(undefined, 'month') %>" class="<%= range === 'month' ? 'active' : '' %>">Þennan mánuð</a>
  </div>

  <div class="card">
    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <h3>Ekkert framundan ennþá</h3>
        <p>Afmælis- og jólapantanir birtast hér sjálfkrafa. Notaðu „Sérpöntun" fyrir stöðuhækkanir, nýja starfsmenn og önnur sérstök tilefni.</p>
      </div>
    <% } else { %>
      <div class="table-scroll">
      <table>
        <thead><tr><th>Starfsmaður</th><th>Tegund</th><th>Dagsetning</th><th>Fjárhæð</th><th>Staða</th><th>Athugasemd</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(function(o) { %>
            <tr>
              <td><%= o.employee ? o.employee.name : '—' %></td>
              <td><span class="badge badge-<%= o.gift_type %>"><%= o.occasion || eventTypeLabel(o.gift_type) %></span></td>
              <td><%= o.event ? formatDate(o.event.date) : '—' %></td>
              <td>
                <%= o.budget_amount ? Number(o.budget_amount).toLocaleString('is-IS') + ' kr.' : '—' %>
                <% if (o.handling_fee) { %>
                  <div style="font-size:11.5px; color:var(--text-muted); font-weight:600;">+ <%= Number(o.handling_fee).toLocaleString('is-IS') %> kr. gjald</div>
                <% } %>
              </td>
              <td><span class="badge badge-<%= o.status %>"><%= statusLabel(o.status) %></span></td>
              <td style="min-width:180px;">
                <% if (o.canEditNote) { %>
                  <form class="inline note-form" method="POST" action="/gift-orders/<%= o.id %>/note">
                    <input type="hidden" name="redirect_to" value="/gift-orders">
                    <input type="text" name="notes" value="<%= o.notes || '' %>" placeholder="athugasemd">
                    <button type="submit" class="btn btn-sm btn-secondary">Vista</button>
                  </form>
                <% } else { %>
                  <span class="locked-note" title="Læst - innan við <%= NOTE_CUTOFF_DAYS %> dagar til stefnu">
                    <%= o.notes || '—' %> <span style="opacity:0.7;">🔒</span>
                  </span>
                <% } %>
              </td>
              <td class="actions-cell">
                <% if (o.canCancel) { %>
                  <form class="inline" method="POST" action="/gift-orders/<%= o.id %>/cancel" onsubmit="return confirm('Hætta við þessa sérpöntun?');">
                    <button type="submit" class="btn btn-sm btn-danger">Hætta við</button>
                  </form>
                <% } else if (o.gift_type === 'custom' && o.status !== 'delivered' && o.status !== 'cancelled') { %>
                  <span style="font-size:12px; color:var(--text-muted);" title="Of seint að hætta við - þarf að gerast minnst 7 dögum fyrir afhendingu.">Of seint</span>
                <% } else if (o.canSkip) { %>
                  <form class="inline" method="POST" action="/gift-orders/<%= o.id %>/skip" onsubmit="return confirm('Hætta við þessari gjöf?');">
                    <button type="submit" class="btn btn-sm btn-danger">Hætta við</button>
                  </form>
                <% } else if (o.canRestore) { %>
                  <form class="inline" method="POST" action="/gift-orders/<%= o.id %>/restore" onsubmit="return confirm('Taka þessa pöntun til baka?');">
                    <button type="submit" class="btn btn-sm btn-success">Taka til baka</button>
                  </form>
                <% } else if (o.status === 'cancelled') { %>
                  <span style="font-size:12px; color:var(--text-muted);" title="Of seint að taka til baka - dagsetningin er of nálægt eða liðin.">Of seint</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

<%- include('../partials/footer') %>
