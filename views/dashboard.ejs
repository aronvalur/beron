<%- include('partials/head', { title: 'Yfirlit' }) %>
<%- include('partials/nav') %>

  <div class="page-header">
    <div>
      <h1><%= greeting(currentUser.name) %>, <%= currentUser.name.split(' ')[0] %></h1>
      <p class="subtitle"><%= company.name %> &mdash; hér er það sem er framundan hjá starfsfólkinu þínu.</p>
    </div>
    <a href="/gift-orders/custom/new" class="btn">+ Sérpöntun</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="grid grid-3">
    <div class="card stat-card">
      <div class="stat-value"><%= occasionsNext30Count %></div>
      <div class="stat-label">Tilefni næstu 30 daga</div>
    </div>
    <div class="card stat-card">
      <div class="stat-value"><%= activeEmployeeCount %></div>
      <div class="stat-label">Virkir starfsmenn</div>
    </div>
    <div class="card stat-card">
      <div class="stat-value"><%= monthBilling.grandTotal.toLocaleString('is-IS') %> kr.</div>
      <div class="stat-label">Áætlaður mánaðarreikningur (<%= monthBilling.activeEmployeeCount %> starfsmenn)</div>
      <div style="font-size:12px; color:var(--text-muted); font-weight:600; margin-top:4px;">
        <%= monthBilling.subscriptionTotal.toLocaleString('is-IS') %> kr. áskrift + <%= monthBilling.giftChargeTotal.toLocaleString('is-IS') %> kr. gjafir
      </div>
    </div>
  </div>

  <% if (missingBudgetCount > 0) { %>
    <div class="alert alert-info">
      <%= missingBudgetCount %> virkur starfsmaður <%= missingBudgetCount === 1 ? 'er' : 'eru' %> ekki með skráða gjafafjárhæð.
      <a href="/employees">Bættu því við á starfsmannasíðunni</a> svo Beron viti hversu miklu má eyða í afmælisgjöf.
    </div>
  <% } %>

  <div class="card">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px;">
      <h2 style="margin:0;">Næstu 30 dagar</h2>
      <a href="/gift-orders" class="btn btn-sm">Öll tilefni</a>
    </div>
    <% if (upcomingEvents.length === 0) { %>
      <div class="table-empty">Ekkert framundan næstu 30 daga.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Starfsmaður</th><th>Tegund</th><th>Dagsetning</th><th>Niðurtalning</th><th>Fjárhæð</th><th>Staða pöntunar</th><th>Athugasemd til Beron</th></tr></thead>
        <tbody>
          <% upcomingEvents.forEach(function(ev) { %>
            <tr>
              <td><%= ev.employee ? ev.employee.name : 'Óþekkt' %></td>
              <td><span class="badge badge-<%= ev.event_type %>"><%= (ev.order && ev.order.occasion) || eventTypeLabel(ev.event_type) %></span></td>
              <td><%= formatDate(ev.date) %></td>
              <td>
                <% if (ev.daysAway < 0) { %>
                  <span style="color:var(--text-muted);"><%= Math.abs(ev.daysAway) %> dagar síðan</span>
                <% } else { %>
                  <strong><%= ev.daysAway === 0 ? 'Í dag' : (ev.daysAway === 1 ? 'Á morgun' : ev.daysAway + ' dagar') %></strong>
                <% } %>
              </td>
              <td>
                <% const budget = ev.order ? ev.order.budget_amount : (ev.employee ? ev.employee.birthday_budget : null); %>
                <%= budget ? Number(budget).toLocaleString('is-IS') + ' kr.' : '—' %>
              </td>
              <td>
                <% if (ev.order) { %>
                  <span class="badge badge-<%= ev.order.status %>"><%= statusLabel(ev.order.status) %></span>
                <% } else { %>
                  <span style="font-size:12.5px; color:var(--text-muted);">—</span>
                <% } %>
              </td>
              <td>
                <% if (ev.order && ev.canEditNote) { %>
                  <details class="note-popover">
                    <summary class="note-toggle <%= ev.order.notes ? 'has-note' : '' %>" aria-label="<%= ev.order.notes ? 'Breyta athugasemd' : 'Bæta við athugasemd' %>">
                      <% if (ev.order.notes) { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                      <% } else { %>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      <% } %>
                    </summary>
                    <div class="note-popover-panel">
                      <form method="POST" action="/gift-orders/<%= ev.order.id %>/note">
                        <input type="hidden" name="redirect_to" value="/">
                        <textarea name="notes" placeholder="Athugasemd til Beron"><%= ev.order.notes || '' %></textarea>
                        <button type="submit" class="btn btn-sm btn-secondary" style="width:100%;">Vista</button>
                      </form>
                    </div>
                  </details>
                <% } else if (ev.order && ev.order.notes) { %>
                  <details class="note-popover">
                    <summary class="note-toggle has-note" aria-label="Sjá athugasemd (læst)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </summary>
                    <div class="note-popover-panel">
                      <div class="note-popover-readonly"><%= ev.order.notes %></div>
                      <div class="note-popover-hint">Læst - innan við <%= NOTE_CUTOFF_DAYS %> dagar til stefnu.</div>
                    </div>
                  </details>
                <% } else { %>
                  <span style="font-size:13px; color:var(--text-muted);">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2>Í vinnslu núna</h2>
    <p style="color:var(--text-muted); font-size:13px; margin:-8px 0 14px;">Gjafir sem eru komnar af stað - pantaðar eða á leiðinni til starfsmanns.</p>
    <% if (activeOrders.length === 0) { %>
      <div class="table-empty">Ekkert í vinnslu núna - næsta gjöf fer sjálfkrafa af stað þegar nær dregur tilefninu.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Starfsmaður</th><th>Tegund</th><th>Dagsetning</th><th>Staða</th></tr></thead>
        <tbody>
          <% activeOrders.forEach(function(o) { %>
            <tr>
              <td><%= o.name %></td>
              <td><%= o.typeLabel %></td>
              <td><%= o.date ? formatDate(o.date) : '—' %></td>
              <td><span class="badge badge-<%= o.status %>"><%= statusLabel(o.status) %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <script>
    (function () {
      var popovers = Array.prototype.slice.call(document.querySelectorAll('.note-popover'));

      function positionPanel(details) {
        var summary = details.querySelector('summary');
        var panel = details.querySelector('.note-popover-panel');
        if (!summary || !panel) return;
        var rect = summary.getBoundingClientRect();
        var panelWidth = panel.offsetWidth || 260;
        var left = Math.min(rect.left, window.innerWidth - panelWidth - 12);
        panel.style.top = (rect.bottom + 6) + 'px';
        panel.style.left = Math.max(12, left) + 'px';
      }

      popovers.forEach(function (details) {
        details.addEventListener('toggle', function () {
          if (details.open) {
            popovers.forEach(function (other) {
              if (other !== details) other.open = false;
            });
            positionPanel(details);
          }
        });
      });

      window.addEventListener('scroll', function () {
        popovers.forEach(function (details) {
          if (details.open) positionPanel(details);
        });
      }, true);
      window.addEventListener('resize', function () {
        popovers.forEach(function (details) {
          if (details.open) positionPanel(details);
        });
      });

      document.addEventListener('click', function (e) {
        popovers.forEach(function (details) {
          if (details.open && !details.contains(e.target)) details.open = false;
        });
      });
    })();
  </script>

<%- include('partials/footer') %>
