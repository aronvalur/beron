<%- include('partials/head', { title: 'Yfirlit' }) %>
<%- include('partials/nav') %>

  <div class="page-header">
    <div>
      <h1><%= greeting(currentUser.name) %>, <%= currentUser.name.split(' ')[0] %></h1>
      <p class="subtitle"><%= company.name %> &mdash; hér er það sem er framundan hjá starfsfólkinu þínu.</p>
    </div>
    <a href="/gift-orders/custom/new" class="btn">+ Sérpöntun</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="grid grid-3">
    <div class="card stat-card">
      <div class="stat-value"><%= birthdayChristmasCount %></div>
      <div class="stat-label">Afmæli og jólagjafir næstu 30 daga</div>
    </div>
    <div class="card stat-card">
      <div class="stat-value"><%= activeEmployeeCount %></div>
      <div class="stat-label">Virkir starfsmenn</div>
    </div>
    <div class="card stat-card">
      <div class="stat-value"><%= monthBilling.grandTotal.toLocaleString('is-IS') %> kr.</div>
      <div class="stat-label">Áætlaður mánaðarreikningur (<%= monthBilling.activeEmployeeCount %> starfsmenn)</div>
      <div style="font-size:12px; color:var(--text-muted); font-weight:600; margin-top:4px;">
        <%= monthBilling.subscriptionTotal.toLocaleString('is-IS') %> kr. áskrift + <%= monthBilling.giftChargeTotal.toLocaleString('is-IS') %> kr. gjafir
      </div>
    </div>
  </div>

  <% if (missingBudgetCount > 0) { %>
    <div class="alert alert-info">
      <%= missingBudgetCount %> virkur starfsmaður <%= missingBudgetCount === 1 ? 'er' : 'eru' %> ekki með skráða gjafafjárhæð.
      <a href="/employees">Bættu því við á starfsmannasíðunni</a> svo Beron viti hversu miklu má eyða í afmælisgjöf.
    </div>
  <% } %>

  <div class="card">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px;">
      <h2 style="margin:0;">Næstu 30 dagar</h2>
      <a href="/gift-orders" class="btn btn-sm">Öll tilefni</a>
    </div>
    <% if (upcomingEvents.length === 0) { %>
      <div class="table-empty">Ekkert framundan næstu 30 daga.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Starfsmaður</th><th>Tegund</th><th>Dagsetning</th><th>Niðurtalning</th><th>Fjárhæð</th><th>Staða pöntunar</th><th>Athugasemd til Beron</th></tr></thead>
        <tbody>
          <% upcomingEvents.forEach(function(ev) { %>
            <tr>
              <td><%= ev.employee ? ev.employee.name : 'Óþekkt' %></td>
              <td><span class="badge badge-<%= ev.event_type %>"><%= (ev.order && ev.order.occasion) || eventTypeLabel(ev.event_type) %></span></td>
              <td><%= formatDate(ev.date) %></td>
              <td>
                <% if (ev.daysAway < 0) { %>
                  <span style="color:var(--text-muted);"><%= Math.abs(ev.daysAway) %> dagar síðan</span>
                <% } else { %>
                  <strong><%= ev.daysAway === 0 ? 'Í dag' : (ev.daysAway === 1 ? 'Á morgun' : ev.daysAway + ' dagar') %></strong>
                <% } %>
              </td>
              <td>
                <% const budget = ev.order ? ev.order.budget_amount : (ev.employee ? ev.employee.birthday_budget : null); %>
                <%= budget ? Number(budget).toLocaleString('is-IS') + ' kr.' : '—' %>
              </td>
              <td>
                <% if (ev.order) { %>
                  <span class="badge badge-<%= ev.order.status %>"><%= statusLabel(ev.order.status) %></span>
                <% } else { %>
                  <span style="font-size:12.5px; color:var(--text-muted);">—</span>
                <% } %>
              </td>
              <td>
                <% if (ev.order && ev.canEditNote) { %>
                  <form class="inline note-form" method="POST" action="/gift-orders/<%= ev.order.id %>/note">
                    <input type="hidden" name="redirect_to" value="/">
                    <input type="text" name="notes" value="<%= ev.order.notes || '' %>" placeholder="athugasemd">
                    <button type="submit" class="btn btn-sm btn-secondary">Vista</button>
                  </form>
                <% } else if (ev.order) { %>
                  <span class="locked-note" title="Læst - innan við <%= NOTE_CUTOFF_DAYS %> dagar til stefnu">
                    <%= ev.order.notes || '—' %> <span style="opacity:0.7; font-weight:600;">(læst)</span>
                  </span>
                <% } else { %>
                  <span style="font-size:12.5px; color:var(--text-muted);">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2>Staða allra gjafapantana</h2>
    <p style="color:var(--text-muted); font-size:13px; margin:-8px 0 14px;">Hvar pantanir standa í ferlinu, óháð dagsetningu tilefnis.</p>

    <div class="status-pipeline-row">
      <div class="pipeline">
        <% statusCounts.slice(0, 4).forEach(function(s) { %>
          <div class="pipeline-step">
            <div class="pipeline-dot pipeline-dot-<%= s.status %> <%= s.count === 0 ? 'is-empty' : '' %>"><%= s.count %></div>
            <div class="pipeline-label"><%= statusLabel(s.status) %></div>
            <% if (s.count > 0) { %>
              <div class="pipeline-tooltip">
                <div class="pipeline-tooltip-title"><%= statusLabel(s.status) %> (<%= s.count %>)</div>
                <ul>
                  <% s.orders.forEach(function(o) { %>
                    <li><%= o.name %> <span>&middot; <%= o.typeLabel %></span></li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>

      <% const cancelled = statusCounts[4]; %>
      <div class="pipeline-aside">
        <div class="pipeline-dot pipeline-dot-cancelled <%= cancelled.count === 0 ? 'is-empty' : '' %>"><%= cancelled.count %></div>
        <div class="pipeline-label"><%= statusLabel(cancelled.status) %></div>
        <% if (cancelled.count > 0) { %>
          <div class="pipeline-tooltip">
            <div class="pipeline-tooltip-title"><%= statusLabel(cancelled.status) %> (<%= cancelled.count %>)</div>
            <ul>
              <% cancelled.orders.forEach(function(o) { %>
                <li><%= o.name %> <span>&middot; <%= o.typeLabel %></span></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>
