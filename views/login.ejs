<!DOCTYPE html>
<html lang="is">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Innskráning · Beron</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="brand">
        <img src="/images/logo.svg" alt="Beron" class="brand-mark-img">
        <span class="brand-name" style="color:var(--navy);">Beron</span>
      </div>
      <h1>Skráðu þig inn á vinnusvæðið þitt</h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="field">
          <label for="email">Netfang</label>
          <input type="email" id="email" name="email" required autofocus>
        </div>
        <div class="field">
          <label for="password">Lykilorð</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn" style="width:100%;">Skrá inn</button>
      </form>
      <p style="text-align:center; margin-top:14px;"><a href="/forgot-password" style="font-size:13px;">Gleymt lykilorð?</a></p>

      <div class="login-hint">
        Prufuaðgangar &mdash; Tengiliður fyrirtækis: <strong>sigrun@nordictech.is</strong> / beron123<br>
        Starfsmaður Beron: <strong>admin@beron.is</strong> / beron123
      </div>
    </div>
  </div>
</body>
</html>
